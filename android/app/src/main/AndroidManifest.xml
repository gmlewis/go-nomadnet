<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The camera, for reading an address out of a QR code instead of having it typed. It is
         asked for when the reader first presses a dialog's Scan button, not at install: the
         appliance works without it, and a permission prompt on a first launch that has not
         yet mentioned scanning is a prompt about nothing. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A radio on the tablet's USB port. Not every device can host one, so the appliance
         says the feature is one it uses rather than one it needs, and a tablet without a
         USB port still installs it. The filter that decides which devices the system offers
         the appliance for is res/xml/usb_device_filter.xml, named by the activity below. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- A camera, for the same reason and with the same answer: the appliance scans QR codes
         where a device has a camera and offers no Scan button where it does not, so a device
         without one must still be offered the app. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- The appliance's own theme, which is the platform's with the window's colours set
         to the console's: the device's default theme puts the device's accent colour in the
         status bar, which is a bright bar across the top of a dark terminal. It is declared
         here rather than on the activity so that the window is themed before the activity
         is created, which is also the window the launcher shows while it starts. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@style/ApplianceTheme">

        <!-- The console lives in this activity: its socket, the host process and the thread
             reading them are all things an activity that is destroyed and rebuilt would have
             to rebuild from scratch, and a client killed by turning the tablet is a terminal
             nobody can use. A rotation is a configuration change, so the activity claims the
             changes it handles itself and is left alone: the window is resized, the console
             measures its cells again and tells the client its new size, and the client
             reflows. The four size changes are the ones a rotation produces and every one of
             them is needed.

             `keyboard` is what an input device appearing changes — a Bluetooth keyboard
             connecting, or being switched off — and it is not a reason to end a session:
             without it here the activity was destroyed and rebuilt the moment a keyboard
             was paired, which killed the client and closed the console out from under the
             person who had just reached for the keys. `keyboardHidden` and `navigation`
             change with the same event and are claimed for the same reason. Density and font
             scale are deliberately not claimed — they change the cell size, and this app
             re-measures the font only when its view is laid out again, so it is better
             served by being rebuilt than by drawing with metrics from the old scale.

             `singleTop` is what a plugged-in radio needs. The intent-filter below registers
             this activity for USB_DEVICE_ATTACHED, because that is what raises the USB
             permission dialog, so every attach is an intent for this activity — and in the
             default launch mode that intent is a *second* instance started over the one
             showing the console, which reads as a crash and is not one. Declared singleTop,
             the instance that is already there receives it through onNewIntent and keeps
             whatever it is showing. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The radio's own chooser. Android matches an attached USB device against
                 every application's filter and asks the person which of them should have
                 it; an application with no filter is never in that list. The meta-data
                 names the filter, and the filter names the devices: the USB-serial bridges
                 RNode hardware presents. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- The scanner the client's dialogs borrow. It is not exported, so nothing but this
             app can start it, and it is declared with the appliance's own theme because it is
             the same dark screen rather than a light one flashed up for a moment in the
             middle of a terminal. It claims the two orientation changes so that turning the
             tablet while aiming does not restart the preview, which is what the reader is
             looking at; the preview turns with the display instead. -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/ApplianceTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />

        <service
            android:name=".SensorService"
            android:exported="false"
            android:foregroundServiceType="location|connectedDevice|dataSync" />
    </application>
</manifest>
