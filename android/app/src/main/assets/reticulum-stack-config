# Reticulum config for the ATTACHED mode: gonomadnet in Termux using the
# appliance's transport instead of owning one of its own.
#
# Installed to ~/.reticulum-stack/config. The standalone mode's config lives at
# ~/.reticulum/config and is not touched by anything here.
#
# This config deliberately declares NO interfaces of its own: the appliance's
# bundled gornsd owns every interface on this tablet, and a second transport with
# its own interfaces would build a second, invisible Reticulum network on the same
# device. That is also why its launcher needs no hostname resolution block: there
# is no target_host here to keep alive.

[reticulum]

  # Do not route for other nodes. The transport that owns the interfaces does that.
  enable_transport = no

  # Attach to the appliance's shared instance rather than creating one.
  share_instance = yes
  shared_instance_type = tcp
  shared_instance_port = 37428
  instance_name = default

  # NEVER take ownership. Without this, gonomadnet tries to become the shared
  # instance first and only falls back to attaching if the bind fails, so a client
  # started a moment too early would quietly become the transport and the
  # appliance's gornsd would then fail to start. Failing loudly is the right
  # behaviour: "no shared instance is running" is a message the launcher turns into
  # something a person can act on.
  require_shared_instance = yes

[logging]
  loglevel = 4

[interfaces]
  # Deliberately empty. See the note at the top of this file.
