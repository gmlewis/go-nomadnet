#
# gonomadnet launcher shim (Termux:Widget target script).
# Tap the "gonomadnet" home-screen icon to run this.
#
# Before launching it refreshes the Reticulum TCP hub address.
#
# WHY: Android ships no /etc/resolv.conf -- /etc is a read-only symlink to
# /system/etc -- and this binary is built CGO_ENABLED=0, so it resolves names
# with Go's own resolver, which falls back to 127.0.0.1:53 / [::1]:53 when
# that file is missing. Every lookup therefore fails with:
#     dial tcp: lookup go-nomadnet.duckdns.org on [::1]:53: connection refused
# Android's real resolver lives behind netd and is only reachable through
# bionic (libc), which a pure-Go binary cannot call. So the hub name is
# resolved here with bionic -- via /system/bin/ping6, an Android system binary
# -- and the resulting literal address is pinned into the Reticulum config.
#
# The hub name stays the source of truth: it is re-resolved on every launch,
# so a DuckDNS address change is picked up automatically.

HUB_HOST=go-nomadnet.duckdns.org
CONF="$HOME/.reticulum/config"

cd "$HOME" || exit 1

if [ ! -x "$HOME/gonomadnet" ]; then
  echo "gonomadnet is not installed at $HOME/gonomadnet"
  echo
  echo "To install/repair it, tap 'Publish files for Termux' in the"
  echo "'gonomadnet node' app, then tap 'Set up Termux' there, or run:"
  echo "  bash /sdcard/Download/gonomadnet-setup.sh"
  echo
  read -r -p "Press Enter to close..." _
  exit 1
fi

# resolve_hub_addr prints the hub's IPv6 address, or the name itself if
# resolution failed (so the failure surfaces in the log instead of silently
# pinning a stale address).
resolve_hub_addr() {
  local line addr
  line=$(/system/bin/ping6 -n -c 1 -W 3 "$HUB_HOST" 2>/dev/null | head -n 1)
  addr=${line#*(}   # drop everything up to the first "("
  addr=${addr%)*}   # drop from the last ")" onward
  if [ -z "$addr" ] || [ "$addr" = "$line" ]; then
    echo "$HUB_HOST"
    return
  fi
  echo "$addr"
}

# refresh_hub_addr rewrites only the target_host line, leaving any other edit
# to the config intact, and only when the address actually changed.
refresh_hub_addr() {
  [ -f "$CONF" ] || return 0
  local addr old
  addr=$(resolve_hub_addr)
  old=$(grep -m 1 'target_host' "$CONF" 2>/dev/null)
  old=${old#*=}
  old=${old//[[:space:]]/}
  if [ "$addr" = "$old" ]; then
    return 0
  fi
  echo "gonomadnet: hub $HUB_HOST -> $addr"
  if sed "s|^\([[:space:]]*target_host[[:space:]]*=\).*|\1 $addr|" "$CONF" > "$CONF.new"; then
    mv "$CONF.new" "$CONF"
    chmod 600 "$CONF"
  else
    rm -f "$CONF.new"
    echo "gonomadnet: could not update $CONF; using address as-is"
  fi
}

# peer_running reports whether another gonomadnet is already up.
#
# Only argv[0] is examined, and only an executable whose name is exactly
# "gonomadnet" counts. Matching the whole command line would be wrong in a way that is
# easy to miss: the launcher scripts' own paths contain the word "gonomadnet", so a
# substring match makes every launcher refuse to start on the grounds that it has
# found itself.
#
# procfs is read directly rather than shelling out to ps, because Termux's $PATH has
# no ps and Android's seccomp policy terminates a process that resolves a bare program
# name. See cmd/gonomadnet/instance-lock-unix.go, which reads procfs for the same two
# reasons.
peer_running() {
  local pid argv0
  for pid in /proc/[0-9]*; do
    case "${pid##*/}" in "$$") continue ;; esac
    argv0="$(tr '\0' '\n' < "$pid/cmdline" 2>/dev/null | head -n 1)" || continue
    case "$argv0" in
      */gonomadnet|gonomadnet) echo "$pid was running: $argv0"; return 0 ;;
    esac
  done
  return 1
}

if peer="$(peer_running)"; then
  echo "=============================================================="
  echo " A gonomadnet is already running, so this one was not started."
  echo
  echo "$peer"
  echo
  echo " Both modes share ~/.nomadnetwork, so they are mutually exclusive."
  echo " Running both at once would give the tablet two separate Reticulum"
  echo " networks with no visibility between them."
  echo
  echo " Stop the running one (Ctrl-Q in its session), then tap this icon again."
  echo " If it was started by the appliance, stop the stack in the app first."
  echo "=============================================================="
  read -r -p "Press Enter to close..." _
  exit 1
fi

# ---------------------------------------------------------------------------
# The appliance's stack
# ---------------------------------------------------------------------------
#
# The appliance cannot see into Termux: another application's private data and its
# process list are both closed to it, so it cannot tell whether this mode is
# already running. This side can tell the other way round, because the appliance
# publishes its shared instance on loopback where anyone may look. So the check
# lives here, and it is the one that matters: this mode owns its own Reticulum
# network, and so does the appliance, and running both puts two independent
# networks on one tablet with no visibility between them.
appliance_stack_running() {
  (exec 3<>/dev/tcp/127.0.0.1/37428) 2>/dev/null || return 1
  exec 3<&- 2>/dev/null || true
  return 0
}

if appliance_stack_running; then
  echo "=============================================================="
  echo " The appliance's stack is running."
  echo
  echo " Something is listening on 127.0.0.1:37428, which is where the"
  echo " gonomadnet appliance publishes its shared instance. This icon runs"
  echo " the tablet's OWN Reticulum network, so starting it now would put"
  echo " two independent networks on this tablet with no visibility between"
  echo " them -- and they share ~/.nomadnetwork, so whichever starts second"
  echo " would be refused by the config lock anyway."
  echo
  echo " Either stop the stack in the 'gonomadnet node' app and tap this icon"
  echo " again, or tap the 'gonomadnet+stack' icon to join the appliance"
  echo " instead. That one also gives you the tablet's live position."
  echo "=============================================================="
  read -r -p "Press Enter to close..." _
  exit 1
fi

refresh_hub_addr

# Keep the CPU/Wi-Fi alive so the node is not suspended by Doze while the
# screen is off. Best effort: termux-wake-lock ships with core termux-tools.
termux-wake-lock >/dev/null 2>&1

exec "$HOME/gonomadnet" -t
