#
# Copy this file to keystore.properties and fill it in, or run
# scripts/build-android-apk.sh --help for the keytool command that creates the
# keystore. keystore.properties itself is gitignored, and so is the keystore:
# it is a long-lived artifact that belongs to whoever releases the app, not to
# the repository.
storeFile=/absolute/path/to/gonomadnet-release.jks
storePassword=change-me
keyAlias=gonomadnet
keyPassword=change-me
