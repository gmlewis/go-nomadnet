# Two texts the appliance carries as source data rather than scratch, and which the
# *.txt rule above would otherwise drop from the repository: the King James Version,
# which is 4.4 MB and which the APK cannot be built without, and the license that has
# to travel with the Nerd Font the APK hands to the terminal.
!android/app/src/main/assets/kjv.txt
!android/app/src/main/assets/AtkinsonHyperlegibleMono-OFL.txt
/.agents
/.claude
/.dsh
/original*
/skills/
/test-all.sh
go.work*
__pycache__

# Android release staging: the APK scripts/build-android-apk.sh leaves for the
# release publisher. Build output, never committed.
dist/

# The launcher icon's Android resource directories, staged from assets/ by
# scripts/build-android-apk.sh on every APK build. Derived from the rendered icon
# family in assets/, and regenerated whenever one of those files changes, so what
# lives in the repository is the icon itself and never a second copy of it.
android/app/src/main/res/mipmap-*/
